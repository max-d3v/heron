{
  "name": "@heron/desktop",
  "productName": "Heron",
  "version": "0.1.0",
  "description": "Automatic PR reviews with your own Claude subscription",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Heron",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never --config electron-builder.yml"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@octokit/rest": "^22.0.1",
    "@orpc/client": "^1.16.1",
    "@orpc/contract": "^1.16.1",
    "@orpc/server": "^1.16.1",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@heron/config": "workspace:*",
    "@heron/core": "workspace:*",
    "@heron/db": "workspace:*",
    "@heron/git": "workspace:*",
    "@heron/github": "workspace:*",
    "@heron/harness": "workspace:*",
    "@heron/platform": "workspace:*",
    "@heron/rpc": "workspace:*",
    "@orpc/tanstack-query": "^1.16.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
